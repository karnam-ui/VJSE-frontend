// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model Lead {
  id              Int                @id @default(autoincrement())
  name            String
  email           String
  domain          String
  organization    String
  city            String             @default("")
  skills          String             @default("")
  verified        Boolean            @default(false)
  status          String             @default("Pending") // "Pending" | "Approved" | "Rejected"
  rejectionReason String             @default("")
  invited         Boolean            @default(false)
  sourcerId       Int?
  sourcer         User?              @relation("SourcerLeads", fields: [sourcerId], references: [id])
  createdAt       DateTime           @default(now())
  connections     ConnectionRequest[]
  chatMessages    ChatMessage[]
  rejectionLogs   SourcerRejectionLog[]
  inviteToken     String?
  inviteAccepted  Boolean                @default(false)
  approvedByVolunteerId  Int?
  approvedByVolunteer    User?    @relation("VolunteerApprovals", fields: [approvedByVolunteerId], references: [id])
  approvedAt             DateTime?
  mentorUserId           Int?
  mentorUser             User?    @relation("MentorAccount", fields: [mentorUserId], references: [id])
}

model User {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique
  password           String?
  googleId           String?             @unique
  name               String
  role               String              // "Student" | "Mentor" | "Founder" | "Volunteer" | "Admin"
  createdAt          DateTime            @default(now())
  startupProfile     StartupProfile?
  connectionRequests ConnectionRequest[]
  chatMessages       ChatMessage[]
  submittedLeads     Lead[]             @relation("SourcerLeads")
  rejectionCount     Int                    @default(0)
  isBlocked          Boolean                @default(false)
  rejectionLogs      SourcerRejectionLog[]
  phone              String?
  year               String?
  branch             String?
  profileCompleted   Boolean  @default(false)
  approvedLeads      Lead[]   @relation("VolunteerApprovals")
  designation        String?
  experience         String?
  linkedIn           String?
  bio                String?
  hasSeenWelcome     Boolean  @default(false)
  hasLinkedAccount   Boolean  @default(false)
  mentorConnections  Lead[]   @relation("MentorAccount")
}

model StartupProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  stage       String
  focus       String
  currentGoal String
  createdAt   DateTime @default(now())
  tagline             String?
  problemStatement    String?
  solution            String?
  teamSize            String?
  helpNeeded          String?
  website             String?
  demoLink            String?
  achievement         String?
  trlLevel            String?
}

model ConnectionRequest {
  id        Int      @id @default(autoincrement())
  userId    Int      // Sender (Founder)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId    Int      // Receiver (Lead)
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status        String   // "Pending" | "Intro Made" | "Connected"
  createdAt     DateTime @default(now())
  rejectionLogs SourcerRejectionLog[]
  sourcerResponse      String?
  sourcerRespondedAt   DateTime?
  mentorNotifiedAt     DateTime?
  sourcerInviteToken   String?

  @@unique([userId, leadId])
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  userId    Int      // Sender or Receiver (Founder)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId    Int      // Sender or Receiver (Lead)
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sender    String   // "Founder" | "Lead" (to indicate who sent the message)
  content   String
  createdAt DateTime @default(now())
}

model SourcerRejectionLog {
  id           Int               @id @default(autoincrement())
  sourcerId    Int
  sourcer      User              @relation(fields: [sourcerId], references: [id])
  leadId       Int
  lead         Lead              @relation(fields: [leadId], references: [id])
  connectionId Int
  connection   ConnectionRequest @relation(fields: [connectionId], references: [id])
  createdAt    DateTime          @default(now())
}
